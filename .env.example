TZ=Europe/Berlin
BASE_URL=https://watch.example.com
JELLYFIN_URL=http://jellyfin:8096
# What a browser opens for "Open in Jellyfin" (when JELLYFIN_URL is an internal address)
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Your own Jellyfin account (everyone else signs in under Settings → Jellyfin):
# an API key (Dashboard → API Keys) plus your Jellyfin user name, or your user name and password
# JELLYFIN_API_KEY=
# JELLYFIN_USER=
# JELLYFIN_PASSWORD=
# JELLYSEERR_URL=http://jellyseerr:5055
# JELLYSEERR_PUBLIC_URL=https://requests.example.com
# JELLYSEERR_API_KEY=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# MAINTAINERR_URL=http://maintainerr:6246
# SUBTITLES_PUBLIC_URL=https://subtitles.example.com
# NOTIFY_URL=http://apprise:8000/notify/watch
# OPENAI_API_KEY=
